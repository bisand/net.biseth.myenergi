                        {
                            "id": "STOP",
                            "label": {
                                "en": "Stopped",
                                "no": "Stoppet",
                                "nl": "Gestopt",
                                "sv": "Stoppad",
                                "de": "Gestoppt"
                            }
                        },
                        {
                            "id": "EXPORT",
                            "label": {
                                "en": "Export",
                                "no": "Eksport",
                                "nl": "Exporteren",
                                "sv": "Export",
                                "de": "Export"
