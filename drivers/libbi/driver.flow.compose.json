        {
            "id": "set_libbi_charge_from_grid",
            "$filter": "capabilities=libbi_charge_from_grid",
            "title": {
                "en": "Turn charge from grid on or off",
                "no": "Slå lading fra strømnettet på eller av",
                "nl": "Laden vanaf het net in- of uitschakelen",
                "sv": "Slå på eller av laddning från elnätet",
                "de": "Laden aus dem Netz ein- oder ausschalten"
            },
            "titleFormatted": {
                "en": "Turn charge from grid [[charge_from_grid]]",
